    bot.answer_callback_query(call.id, "قريباً جداً سيتم تفعيل هذه الميزة!")


# استقبال الصور
@bot.message_handler(content_types=["photo"])
def handle_photos(message):
  chat_id = message.chat.id
  if user_states.get(chat_id) == "waiting_for_images":
    file_id = message.photo[-1].file_id
    file_info = bot.get_file(file_id)
    downloaded_file = bot.download_file(file_info.file_path)
    img_filename = f"img_{chat_id}_{len(user_images.get(chat_id, []))}.jpg"
    with open(img_filename, "wb") as f:
      f.write(downloaded_file)
    if chat_id not in user_images:
      user_images[chat_id] = []
    user_images[chat_id].append(img_filename)
    bot.reply_to(
        message,
        f"✅ تم استقبال الصورة (عدد الصور: {len(user_images[chat_id])}). أرسل غيرها أو اضغط إنهاء.",
    )
  else:
    bot.reply_to(message, "الرجاء اختيار 'تحويل الصور إلى PDF' من القائمة أولاً.")


# استقبال الروابط للتحميل (تيك توك، انستا، يوتيوب)
@bot.message_handler(
    func=lambda msg: user_states.get(msg.chat.id) == "waiting_for_link"
)
def handle_download_link(message):
  chat_id = message.chat.id
  url = message.text.strip()

  if not url.startswith("http"):
    bot.reply_to(
        message, "❌ الرابط غير صحيح، الرجاء إرسال رابط صالح يبدأ بـ http"
    )
    return

  msg_wait = bot.reply_to(
      message, "⏳ جاري المعالجة والتحميل من الرابط، ثوانٍ معدودة..."
  )

  try:
    # إعدادات yt_dlp للتحميل بأفضل جودة
    ydl_opts = {
        "outtmpl": f"media_{chat_id}.%(ext)s",
        "format": "best",
        "noplaylist": True,
    }

    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
      info = ydl.extract_info(url, download=True)
      filename = ydl.prepare_filename(info)

    # إرسال الملف حسب نوعه (فيديو أو صوت)
    with open(filename, "rb") as f:
      if filename.endswith((".mp3", ".m4a", ".wav")):
        bot.send_audio(chat_id, f, caption="🎵 تم تحميل الأغنية/الصوت بنجاح!")
      else:
        bot.send_video(chat_id, f, caption="🎥 تم تحميل الفيديو بنجاح!")

    # حذف الملف المؤقت من السيرفر
    if os.path.exists(filename):
      os.remove(filename)

    bot.delete_message(chat_id, msg_wait.message_id)
    user_states[chat_id] = None

  except Exception as e:
    bot.edit_message_text(
        f"❌حدث خطأ أثناء التحميل:\n`{str(e)}`",
        chat_id,
        msg_wait.message_id,
        parse_mode="Markdown",
    )


if __name__ == "__main__":
  print("🔥 البوت الخارق يعمل الآن بكامل الميزات (صور، PDF، تحميل ميديا)...")
  bot.infinity_polling()

